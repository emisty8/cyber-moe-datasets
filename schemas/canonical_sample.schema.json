{
  "$defs": {
    "FunctionCall": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "title": "FunctionCall",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "default": "",
          "title": "Content",
          "type": "string"
        },
        "tool_calls": {
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "title": "Tool Calls",
          "type": "array"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        }
      },
      "required": [
        "role"
      ],
      "title": "Message",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "source_url": {
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "transformation": {
          "minLength": 1,
          "title": "Transformation",
          "type": "string"
        },
        "synthetic": {
          "default": false,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "document_id",
        "source_url",
        "raw_sha256",
        "transformation"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "function",
          "default": "function",
          "title": "Type",
          "type": "string"
        },
        "function": {
          "$ref": "#/$defs/FunctionCall"
        }
      },
      "required": [
        "id",
        "function"
      ],
      "title": "ToolCall",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sample_id": {
      "minLength": 1,
      "title": "Sample Id",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_version": {
      "minLength": 1,
      "title": "Source Version",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "task_type": {
      "minLength": 1,
      "title": "Task Type",
      "type": "string"
    },
    "security_domain": {
      "minLength": 1,
      "title": "Security Domain",
      "type": "string"
    },
    "difficulty": {
      "default": "basic",
      "enum": [
        "basic",
        "intermediate",
        "advanced"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "category": {
      "enum": [
        "soc",
        "security_reasoning",
        "tool_workflow",
        "general",
        "structured"
      ],
      "title": "Category",
      "type": "string"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/Message"
      },
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "expected_answer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Answer"
    },
    "evidence_references": {
      "items": {
        "type": "string"
      },
      "title": "Evidence References",
      "type": "array"
    },
    "attack_technique_ids": {
      "items": {
        "type": "string"
      },
      "title": "Attack Technique Ids",
      "type": "array"
    },
    "tools": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Tools",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "license": {
      "minLength": 1,
      "title": "License",
      "type": "string"
    },
    "verification_status": {
      "enum": [
        "source_grounded",
        "human_verified",
        "unverified",
        "synthetic"
      ],
      "title": "Verification Status",
      "type": "string"
    },
    "split": {
      "default": "unassigned",
      "enum": [
        "unassigned",
        "calibration",
        "train",
        "validation",
        "evaluation"
      ],
      "title": "Split",
      "type": "string"
    },
    "token_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Token Count"
    },
    "token_method": {
      "default": "unavailable",
      "title": "Token Method",
      "type": "string"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "benchmark": {
      "default": false,
      "title": "Benchmark",
      "type": "boolean"
    }
  },
  "required": [
    "sample_id",
    "source_id",
    "source_version",
    "scenario_id",
    "task_type",
    "security_domain",
    "category",
    "messages",
    "provenance",
    "license",
    "verification_status"
  ],
  "title": "Sample",
  "type": "object"
}