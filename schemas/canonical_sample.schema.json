{
  "$defs": {
    "EventEvidence": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "native_id": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Native Id",
          "type": "object"
        },
        "source_dataset": {
          "minLength": 1,
          "title": "Source Dataset",
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "timestamp": {
          "minLength": 1,
          "title": "Timestamp",
          "type": "string"
        },
        "index": {
          "minLength": 1,
          "title": "Index",
          "type": "string"
        },
        "sourcetype": {
          "minLength": 1,
          "title": "Sourcetype",
          "type": "string"
        },
        "host": {
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "raw": {
          "minLength": 1,
          "title": "Raw",
          "type": "string"
        },
        "fields": {
          "additionalProperties": true,
          "title": "Fields",
          "type": "object"
        }
      },
      "required": [
        "event_id",
        "native_id",
        "source_dataset",
        "source_version",
        "timestamp",
        "index",
        "sourcetype",
        "host",
        "source",
        "raw",
        "fields"
      ],
      "title": "EventEvidence",
      "type": "object"
    },
    "FunctionCall": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "title": "FunctionCall",
      "type": "object"
    },
    "MCPReference": {
      "additionalProperties": false,
      "properties": {
        "server_id": {
          "minLength": 1,
          "title": "Server Id",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "schema_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Schema Sha256",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "server_id",
        "schema_version",
        "schema_sha256",
        "synthetic"
      ],
      "title": "MCPReference",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "default": "",
          "title": "Content",
          "type": "string"
        },
        "tool_calls": {
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "title": "Tool Calls",
          "type": "array"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        }
      },
      "required": [
        "role"
      ],
      "title": "Message",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "source_url": {
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "transformation": {
          "minLength": 1,
          "title": "Transformation",
          "type": "string"
        },
        "synthetic": {
          "default": false,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "document_id",
        "source_url",
        "raw_sha256",
        "transformation"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "synthetic_fixture"
          ],
          "title": "Status",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "evidence_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        },
        "proposed_answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Answer"
        },
        "answer_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer Hash"
        }
      },
      "required": [
        "status",
        "evidence_hash"
      ],
      "title": "Review",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "function",
          "default": "function",
          "title": "Type",
          "type": "string"
        },
        "function": {
          "$ref": "#/$defs/FunctionCall"
        }
      },
      "required": [
        "id",
        "function"
      ],
      "title": "ToolCall",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sample_id": {
      "minLength": 1,
      "title": "Sample Id",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_version": {
      "minLength": 1,
      "title": "Source Version",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "task_type": {
      "minLength": 1,
      "title": "Task Type",
      "type": "string"
    },
    "security_domain": {
      "minLength": 1,
      "title": "Security Domain",
      "type": "string"
    },
    "difficulty": {
      "default": "basic",
      "enum": [
        "basic",
        "intermediate",
        "advanced"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "category": {
      "enum": [
        "soc",
        "security_reasoning",
        "tool_workflow",
        "general",
        "structured"
      ],
      "title": "Category",
      "type": "string"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/Message"
      },
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "expected_answer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Answer"
    },
    "evidence_references": {
      "items": {
        "type": "string"
      },
      "title": "Evidence References",
      "type": "array"
    },
    "attack_technique_ids": {
      "items": {
        "type": "string"
      },
      "title": "Attack Technique Ids",
      "type": "array"
    },
    "tools": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Tools",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "license": {
      "minLength": 1,
      "title": "License",
      "type": "string"
    },
    "verification_status": {
      "enum": [
        "source_grounded",
        "human_verified",
        "unverified",
        "synthetic"
      ],
      "title": "Verification Status",
      "type": "string"
    },
    "split": {
      "default": "unassigned",
      "enum": [
        "unassigned",
        "calibration",
        "train",
        "validation",
        "evaluation"
      ],
      "title": "Split",
      "type": "string"
    },
    "token_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Token Count"
    },
    "token_method": {
      "default": "unavailable",
      "title": "Token Method",
      "type": "string"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "benchmark": {
      "default": false,
      "title": "Benchmark",
      "type": "boolean"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/EventEvidence"
      },
      "title": "Events",
      "type": "array"
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/Review"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mcp_schema": {
      "anyOf": [
        {
          "$ref": "#/$defs/MCPReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "sample_id",
    "source_id",
    "source_version",
    "scenario_id",
    "task_type",
    "security_domain",
    "category",
    "messages",
    "provenance",
    "license",
    "verification_status"
  ],
  "title": "Sample",
  "type": "object"
}
